{
  "expo": {
    "name": "navalt-fsrr",
    "slug": "navalt-fsrr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "navaltfsrr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
       ["expo-location", { "locationWhenInUsePermission": "Navalt FSR records where each service visit took place." }],
       ["expo-image-picker", {
  "photosPermission": "This app uses your photos to attach pictures to service reports.",
  "cameraPermission": "This app uses the camera to take photos for service reports."
}],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/om-logo.png",
          "imageWidth": 240


        }
      ],
      "expo-sharing",
      "expo-mail-composer",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
